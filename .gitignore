*.exe
*.out
*.app
*.dSYM/
*.su

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Specific Assignment Executables (to prevent accidentally committing runtimes)
**/countnames
**/shell

# Core dumps
core
vgcore.*

# Temporary worksheet execution files
fake_home/
run_worksheet.sh

