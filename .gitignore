# macOS System Files
.DS_Store
.AppleDouble
.LSOverride

# VS Code IDE
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Compiled Object files
*.o
*.obj

# Executables
